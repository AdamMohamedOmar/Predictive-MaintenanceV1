\@writefile{toc}{\contentsline {section}{List of Acronyms}{xiii}{table.1}\protected@file@percent }
\newacro{OBD-II}[\AC@hyperlink{OBD-II}{OBD-II}]{On-Board Diagnostics, second generation --- the standardized vehicle diagnostic interface mandated on passenger cars since 1996}
\newacro{PID}[\AC@hyperlink{PID}{PID}]{Parameter ID --- one addressable sensor or computed value in the OBD-II protocol (e.g.\ 0x0C = engine RPM)}
\newacro{ELM327}[\AC@hyperlink{ELM327}{ELM327}]{The de-facto standard microcontroller that bridges the OBD-II bus to a serial (Bluetooth/USB) link using AT commands}
\newacro{ECU}[\AC@hyperlink{ECU}{ECU}]{Engine Control Unit --- the embedded computer that manages fueling, ignition and emissions}
\newacro{MAF}[\AC@hyperlink{MAF}{MAF}]{Mass Air Flow sensor --- measures intake airflow directly}
\newacro{MAP}[\AC@hyperlink{MAP}{MAP}]{Manifold Absolute Pressure sensor --- measures intake manifold pressure; the airflow reference on speed-density engines}
\newacro{XGBoost}[\AC@hyperlink{XGBoost}{XGBoost}]{eXtreme Gradient Boosting --- a gradient-boosted decision tree library}
\newacro{SHAP}[\AC@hyperlink{SHAP}{SHAP}]{SHapley Additive exPlanations --- a game-theoretic method for attributing a model prediction to its input features}
\newacro{ML}[\AC@hyperlink{ML}{ML}]{Machine Learning}
\newacro{LOFO}[\AC@hyperlink{LOFO}{LOFO}]{Leave-One-Family-Out cross-validation (holding out an entire session family, e.g.\ all idle recordings)}
\newacro{LOSO}[\AC@hyperlink{LOSO}{LOSO}]{Leave-One-Session-Out cross-validation}
\newacro{LTFT}[\AC@hyperlink{LTFT}{LTFT}]{Long-Term Fuel Trim --- the ECU's learned, persistent fuel correction, in percent}
\newacro{STFT}[\AC@hyperlink{STFT}{STFT}]{Short-Term Fuel Trim --- the ECU's fast, oscillating fuel correction, in percent}
\newacro{DTC}[\AC@hyperlink{DTC}{DTC}]{Diagnostic Trouble Code --- the standardized fault code that turns on the check-engine light}
\newacro{API}[\AC@hyperlink{API}{API}]{Application Programming Interface}
\newacro{CSV}[\AC@hyperlink{CSV}{CSV}]{Comma-Separated Values file format}
\newacro{RPM}[\AC@hyperlink{RPM}{RPM}]{Revolutions Per Minute (engine speed)}
\newacro{IAT}[\AC@hyperlink{IAT}{IAT}]{Intake Air Temperature}
\newacro{TPS}[\AC@hyperlink{TPS}{TPS}]{Throttle Position Sensor}
\newacro{APK}[\AC@hyperlink{APK}{APK}]{Android Package --- the installable Android application format}
\newacro{BOM}[\AC@hyperlink{BOM}{BOM}]{Byte Order Mark --- a Unicode signature at the start of a text file}
\newacro{Kafka}[\AC@hyperlink{Kafka}{Kafka}]{Apache Kafka --- a distributed event-streaming platform}
\newacro{REST}[\AC@hyperlink{REST}{REST}]{REpresentational State Transfer --- an HTTP API architectural style}
