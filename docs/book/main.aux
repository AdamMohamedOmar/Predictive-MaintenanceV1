\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The column-shift defect seen through one PID. Left: under a bare \texttt  {read\_csv}, the TIMING\_ADVANCE column contains a large population far outside the $\pm $64$^{\circ }$ OBD-II bound (dashed lines), peaking at 776.6$^{\circ }$ --- catalyst temperatures wearing the wrong column name. Right: with \texttt  {index\_col=False} the same files yield $-24^{\circ }$ to $+35^{\circ }$, entirely inside the physical range. Note the logarithmic count axis.}}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:timingfix}{{2}{13}{The column-shift defect seen through one PID. Left: under a bare \texttt {read\_csv}, the TIMING\_ADVANCE column contains a large population far outside the $\pm $64$^{\circ }$ OBD-II bound (dashed lines), peaking at 776.6$^{\circ }$ --- catalyst temperatures wearing the wrong column name. Right: with \texttt {index\_col=False} the same files yield $-24^{\circ }$ to $+35^{\circ }$, entirely inside the physical range. Note the logarithmic count axis}{figure.caption.4}{}}
